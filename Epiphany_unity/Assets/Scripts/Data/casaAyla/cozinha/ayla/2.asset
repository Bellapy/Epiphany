  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: 2
  m_EditorClassIdentifier: 
  speakerName: Ayla
  speakerPortrait: {fileID: -7319006059537635548, guid: 76804bf5f896d654ca7271eada5c222e, type: 3}
  dialogueLines:
  - sentence: "Sei que \xE0s vezes tudo parece t\xE3o desafiador\u2026\r\n mas voc\xEA
      pode confiar em mim.\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Serei o seu porto seguro, a sua\u2026 verdadeira amiga.\r\n Vou te
      mostrar coisas muito divertidas por aqui!\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "E depois\u2026 bom, n\xF3s arranjamos um jeito de voc\xEA voltar para
      casa.\r\n Por enquanto, caso queira, minha casa est\xE1 de portas abertas para
      voc\xEA."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Est\xE1 come\xE7ando a escurecer l\xE1 fora\u2026\r\n e eu queria
      te mostrar algo muito legal."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Vamos l\xE1?\r\n Prometo que vale a pena sair um pouco."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Vem! \xE9 s\xF3 me seguir! n\xE3o \xE9 longe daqui"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
