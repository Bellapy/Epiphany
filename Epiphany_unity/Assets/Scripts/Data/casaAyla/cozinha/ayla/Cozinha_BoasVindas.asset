  speakerPortrait: {fileID: -7597966105837201831, guid: 38a9defcf1a5a184d9d90ec7641c4d51, type: 3}
  dialogueLines:
  - sentence: "Ah \u2014 ol\xE1! Desculpe, pequena, eu esqueci de desativar o mecanismo
      das luzes na porta. Espero que voc\xEA n\xE3o tenha ficado presa por muito
      tempo. "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Escuta: pode dar uma olhadinha no bolo pra mim? Fica \xE0 vontade
      para sentar quando quiser \u2014 o ch\xE1 est\xE1 pronto e quentinho."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
