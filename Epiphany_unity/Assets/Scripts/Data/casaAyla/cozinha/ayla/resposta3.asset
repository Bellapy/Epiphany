    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Algumas coisas simplesmente acontecem\u2026"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: " e, quando acontecem, nos d\xE3o a chance de aprender\r\n e descobrir
