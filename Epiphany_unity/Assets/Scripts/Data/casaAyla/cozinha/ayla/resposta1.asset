  speakerPortrait: {fileID: -7319006059537635548, guid: 76804bf5f896d654ca7271eada5c222e, type: 3}
  dialogueLines:
  - sentence: "A \xC1rvore da Vida \xE9 a alma de Zelfin.\r\n Tudo que vive aqui
      depende dela.\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Ela tamb\xE9m sente cada mudan\xE7a, cada cuidado\u2026 ou descuido.\r\n
      Cuidar dela n\xE3o \xE9 s\xF3 meu trabalho,\r\n \xE9 um dever de todos que
      vivem aqui."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
