  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: Livro_ExpansaoUniverso
  m_EditorClassIdentifier: 
  speakerName: "Expans\xE3o do Universo"
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "Muito al\xE9m das estrelas que podemos ver, o universo se estende
      infinitamente. Gal\xE1xias giram, estrelas nascem e morrem"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: ' e mundos desconhecidos surgem a cada instante. Planetas colidem,
      buracos negros engolem tudo ao redor'
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "e a dan\xE7a c\xF3smica continua sem cessar. Ler isso \xE9 perceber
      que somos pequenos, "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "mas tamb\xE9m parte de algo grandioso, eterno e sempre em expans\xE3o."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
