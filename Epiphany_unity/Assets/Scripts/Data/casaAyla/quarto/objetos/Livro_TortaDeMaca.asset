  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: Livro_TortaDeMaca
  m_EditorClassIdentifier: 
  speakerName: "Receita de Torta de Ma\xE7a"
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "Em uma cozinha acolhedora, ma\xE7\xE3s frescas eram cuidadosamente
      cortadas em fatias perfeitas"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "misturadas com a\xE7\xFAcar, canela e um toque de lim\xE3o. A massa
      era esticada, dobrada e colocada no forno, "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "liberando um aroma doce e convidativo. Cada peda\xE7o quente trazia
      lembran\xE7as de "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: tardes tranquilas, risadas e o conforto de um lar.
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
