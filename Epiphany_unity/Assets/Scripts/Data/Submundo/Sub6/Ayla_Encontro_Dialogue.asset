  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: Ayla_Encontro_Dialogue
  m_EditorClassIdentifier: 
  speakerName: Ayla
  speakerPortrait: {fileID: -7319006059537635548, guid: 76804bf5f896d654ca7271eada5c222e, type: 3}
  dialogueLines:
  - sentence: "Ent\xE3o era isso... a pequena ondula\xE7\xE3o que senti na harmonia
      do mundo."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Ol\xE1, pequena viajante. Eu sou Ayla, guardi\xE3 de Zelfin. E voc\xEA\u2026 "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "voc\xEA \xE9 o primeiro mist\xE9rio que encontro em s\xE9culos. Bem-vinda\u2026
      eu acho."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Deve estar se sentindo perdida. Eu tamb\xE9m me sinto assim, na verdade,
      mas algo me avisou da sua chegada."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Vamos descobrir juntas o que te trouxe at\xE9 aqui."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Voc\xEA est\xE1 em Zelfin. Contarei mais sobre este lugar quando sairmos
      daqui e subirmos l\xE1 em cima."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Ou voc\xEA realmente achava que este mundo era apenas uma caverna?
      ahahahh"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
