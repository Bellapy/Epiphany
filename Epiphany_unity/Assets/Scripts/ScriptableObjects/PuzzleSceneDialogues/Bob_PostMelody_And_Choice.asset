  speakerName: Bob
  speakerPortrait: {fileID: 7465691506957283280, guid: b12ff3e355cc3c24ca5ca81652b6ac4b, type: 3}
  dialogueLines:
  - sentence: "Pronto. Lindo, n\xE3o \xE9? Tocando, me lembrei de uma frase que acho
      que \xE9 importante pra voc\xEA\u2026\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "\u201CO portal toca uma melodia, a certa abre os cristais\u201D\u2026
      Ou\u2026 algo assim!\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 1
  choicePrompt: "Voc\xEA quer que eu toque de novo?"
  choiceOptions:
  - optionText: im, por favor.
    nextDialogue: {fileID: 0}
  - optionText: "N\xE3o, estou pronta."
    nextDialogue: {fileID: 0}
  nextDialogueOnEnd: {fileID: 0}
