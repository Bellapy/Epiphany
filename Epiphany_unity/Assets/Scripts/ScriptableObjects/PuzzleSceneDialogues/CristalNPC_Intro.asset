  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: CristalNPC_Intro
  m_EditorClassIdentifier: 
  speakerName: Bob
  speakerPortrait: {fileID: 7465691506957283280, guid: b12ff3e355cc3c24ca5ca81652b6ac4b, type: 3}
  dialogueLines:
  - sentence: "Ah, ol\xE1."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "\u2026 \u2026 \u2026 \u2026"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Pera\u2026 ol\xE1?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "\u2026 OL\xC1!"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "N\xE3o imaginei que diria isso algum dia. Ol\xE1, ol\xE1!\nHmm\u2026
      eu tinha algo pra dizer quando algu\xE9m aparecesse\u2026 Mas esse lugar est\xE1
      vazio h\xE1"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "tanto tempo que\u2026 nem me lembro mais.\r\n\xC0s vezes a Ayla vem
      me lembrar disso, sabe? Mas eu n\xE3o sou muito bom de lembrar as"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "coisas. Acho que escolheram o esp\xEDrito errado pra esse posto\u2026\r\nEnfim!
      De qualquer forma\u2026 Eu sei que sei uma melodia da qual n\xE3o esque\xE7o.
      Posso mostrar"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "pra voc\xEA! Quer ver?\r\nBom\u2026 eu vou te mostrar mesmo se n\xE3o
      quiser ver \u2014 acho que \xE9 a forma de passar por aqui."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "\xC9 o mais l\xF3gico de se pensar, n\xE3o \xE9?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Escute com bastante aten\xE7\xE3o\u2026\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: 
          m_MethodName: 
          m_Mode: 0
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  hasChoice: 0
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
