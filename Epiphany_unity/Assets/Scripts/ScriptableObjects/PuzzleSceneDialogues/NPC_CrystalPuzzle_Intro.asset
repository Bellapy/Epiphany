  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: NPC_CrystalPuzzle_Intro
  m_EditorClassIdentifier: 
  speakerName: "M\xFAsico Esquecido"
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - "Ah, ol\xE1. \u2026 \u2026 \u2026 \u2026 Pera\u2026 ol\xE1? \u2026 OL\xC1!\n"
  - "N\xE3o imaginei que diria isso algum dia. Ol\xE1, ol\xE1!"
  - "Hmm\u2026 eu tinha algo pra dizer quando algu\xE9m aparecesse\u2026\nMas esse
    lugar est\xE1 vazio h\xE1 tanto tempo que\u2026 nem me lembro mais."
  - "\xC0s vezes a Ayla vem me lembrar disso, sabe? Mas eu n\xE3o sou muito bom de
    lembrar as coisas.\nAcho que escolheram o esp\xEDrito errado pra esse posto\u2026"
  - "Enfim! De qualquer forma\u2026\nEu sei que sei uma melodia da qual n\xE3o esque\xE7o.\nPosso
    mostrar pra voc\xEA! Quer ver?"
  - "Bom\u2026 eu vou te mostrar mesmo se n\xE3o quiser ver \u2014 acho que \xE9
    a forma de passar por aqui.\n\xC9 o mais l\xF3gico de se pensar, n\xE3o \xE9?"
  - "Escute com bastante aten\xE7\xE3o\u2026"
  - "Pronto. Lindo, n\xE3o \xE9?\nTocando, me lembrei de uma frase que acho que \xE9
    importante pra voc\xEA\u2026"
  - "\u201CO portal toca uma melodia, a certa abre os cristais\u201D\u2026 ou\u2026
    algo assim!\n"
  - "Voc\xEA quer que eu toque de novo?"
  hasChoice: 1
  choiceOptions:
  - Sim, por favor.
  - "N\xE3o, estou pronta."
  isEnvironmentalReflection: 0
  displayDuration: 5
