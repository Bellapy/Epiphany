  speakerName: Veth
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "Ok, ok\u2026 perd\xE3o. Eu realmente estava sendo meio chato. \xC9
      que me preocupo com todos aqui."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "S\xF3 quero o bem de Zelfin. Talvez eu esteja mesmo caindo em hist\xF3rias.\nEnfim,
      enfim!"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Vamos deixar essa conversa pra l\xE1. Que tal um ch\xE1 e um cupcake?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
