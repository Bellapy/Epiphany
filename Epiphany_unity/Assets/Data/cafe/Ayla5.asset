  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: Ayla5
  m_EditorClassIdentifier: 
  speakerName: Ayla
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "Est\xE1 tudo bem. Se tivesse algo acontecendo eu diria, Veth. Pode
      confiar em mim."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Essas hist\xF3rias s\xE3o s\xF3 lendas antigas de Zelfin, j\xE1 ficaram
      para tr\xE1s.\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Poxa\u2026 \xE9 por isso que demoro pra vir aqui \xE0s vezes. Quando
      venho, acabamos sempre nesses assuntos. Nem parecemos aqueles bons amigos do
      passado\u2026"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: ... ... ...
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "\u2026Me desculpe. Eu s\xF3 estou um pouco cansada dessa hist\xF3ria."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
