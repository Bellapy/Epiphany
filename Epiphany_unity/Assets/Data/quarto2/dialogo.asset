  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: dialogo
  m_EditorClassIdentifier: 
  speakerName: Ayla
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "Bom dia! Ontem voc\xEA adormeceu no gramado, ent\xE3o a trouxe para
      este quarto, que at\xE9 agora nunca havia sido usado."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Talvez o colch\xE3o ainda tenha um pouco de p\xF3... mas espero que
      tenha descansado bem!"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Bom...preciso buscar algumas sementes com o Zric e pensei que voc\xEA
      poderia gostar de ir comigo."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Voc\xEA pode seguir pelo caminho de ontem se quiser, mas aqui em Zelfin
      n\xF3s temos as Rubis! (m\xE1quinas de teletransporte)."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Vou configurar para o caso de voc\xEA querer vir."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "At\xE9 logo, pequena! E n\xE3o se esque\xE7a, a senha  \xE9...m in
      a m\xFA s..ic...a"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: ... ... ...
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Voc\xEA perdeu contato com Ayla."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
