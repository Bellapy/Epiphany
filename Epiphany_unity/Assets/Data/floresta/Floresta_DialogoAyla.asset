--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: Floresta_DialogoAyla
  m_EditorClassIdentifier: 
  speakerName: Ayla
  speakerPortrait: {fileID: -7597966105837201831, guid: 38a9defcf1a5a184d9d90ec7641c4d51, type: 3}
  dialogueLines:
  - sentence: "Olhe ao seu redor... nunca me canso de admirar. Perto daqui h\xE1
      uma sequoia-gigante, capaz de chegar a 90 metros de altura "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "\xE9 como uma montanha viva, que respira e continua crescendo por
      milhares de anos."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Quando fico diante de uma \xE1rvore assim, n\xE3o consigo evitar de
      pensar: ser\xE1 que n\xF3s somos pequenos demais, ou elas grandes demais?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Mas a minha favorita \xE9 uma que nem parece real: o Pando. "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Parece uma floresta inteira, mas na verdade todas as \xE1rvores s\xE3o
      geneticamente iguais"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "ou seja, uma \xFAnica \xE1rvore. Suas ra\xEDzes se espalham pelo solo
      h\xE1 mais de 80 mil anos. Imagine s\xF3\u2026"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "J\xE1 estamos chegando!"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
