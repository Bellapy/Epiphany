%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: zric2
  m_EditorClassIdentifier: 
  speakerName: Zric
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "Ohhh, claro, claro! Bom, \xE0s vezes \xE9 melhor esquecer o passado
      mesmo, pequena! Sabe\u2026 come\xE7ar uma nova vida e tudo mais."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Meu nome \xE9 Zric. Sou um \u2018vendedor de cacarecos\u2019, ou melhor,
      um inventor. "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Fa\xE7o coisas e as troco por outras coisas. \xC9 um trabalho bem
      interessante! "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Veja s\xF3: hoje vou trocar com a Ayla algumas sementes de girassol
      por cascos de carac\xF3is \u2014 Uma troca justa. Prazer em te conhecer!\u201D"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Eu geralmente falo demais, sabe? Ent\xE3o se eu come\xE7ar a tagarelar,
      voc\xEA me interrompe! Trabalho aqui nesse posto h\xE1\u2026 bem, alguns bons
      anos\u2026 talvez uns 27 anos. "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Antes disso, era podador de \xE1rvores na cidade, mas aquele trabalho
      me enjoou. Nunca podia usar minha criatividade."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Antes disso, era podResolvi ent\xE3o mudar de vida, criar minhas pr\xF3prias
      inven\xE7\xF5es e troc\xE1-las por outras coisas\u2026 assim vivo feliz! "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Nunca \xE9 tarde para mudar, pequena, principalmente se for para ser
      feliz. "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Enfim, estava pensando\u2026 voc\xEA tem algo para trocar comigo? "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Algo vindo de algum lugar que n\xE3o seja aqui! Seria incr\xEDvel
      para mim e \xF3timo para suas futuras trocas\u2026 "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
