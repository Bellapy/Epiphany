  speakerName: Ayla
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "Ah, j\xE1 vou apresentar voc\xEAs dois! Esta \xE9 a...bom, eu apelidei
      ela de pequena! \xC9 a \xFAnica viajante que apareceu em Zelfin desde que estou
      aqui. "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Veio para um prop\xF3sito maior\u2026 eu imagino! Mas n\xE3o conte
      para muita gente, est\xE1 bem? N\xE3o quero que cause alvoro\xE7o "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "nem que fa\xE7am muitas perguntas. Afinal, nem ela mesma se lembra
      do passado.\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
