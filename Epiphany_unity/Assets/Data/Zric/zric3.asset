  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: zric3
  m_EditorClassIdentifier: 
  speakerName: Zric
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "Hm, t\xE1, t\xE1\u2026 tem raz\xE3o. \xC9 uma not\xEDcia triste, mas
      tudo bem."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: " Sabe, eu simpatizei muito com voc\xEA\u2026 "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Quero te dar um presente mesmo assim, mas s\xF3 trabalho com trocas.
      Que tal me dar uma ajudinha com uma coisinha?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Ent\xE3o... eu estava tentando consertar uma Rubi, mas, veja s\xF3,
      encontrei um probleminha daqueles! "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: " \xC9 que eu n\xE3o enxergo as cores muito bem... uma trag\xE9dia
      pra um inventor, n\xE9? E pra Rubi funcionar direitinho, os l\xEDquidos precisam
      estar na tonalidade perfeita de lil\xE1s! "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Dizem que \xE9 um tom entre o roxo e o rosa, mas pra mim \xE9 tudo
      igual! Ser\xE1 que voc\xEA consegue me ajudar com isso?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Ela est\xE1 aqui do lado, veja se consegue."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
