  dialogueLines:
  - sentence: 'Nunca consegui entender o que isso significa.

'
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: " J\xE1 voc\xEA, pequena\u2026 veio de outra realidade.\r\n"
