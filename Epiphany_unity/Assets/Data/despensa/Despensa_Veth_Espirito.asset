  m_Name: Despensa_Veth_Espirito
  m_EditorClassIdentifier: 
  speakerName: Veth
  speakerPortrait: {fileID: 0}
  dialogueLines:
  - sentence: "E quando ele surgiu \u2014 aquele esp\xEDrito \u2014 proferiu palavras
      que nunca sa\xEDram da minha cabe\xE7a:\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "H\xE1 mundos que nascem da consci\xEAncia\u2026\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: " e consci\xEAncias que moldam o mundo."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: " Onde termina o real \u2014 e come\xE7a o que somos por dentro?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
