%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9228e584220b007488a3081b0ee915e9, type: 3}
  m_Name: Blu_Monologo_Oceano
  m_EditorClassIdentifier: 
  speakerName: Blu
  speakerPortrait: {fileID: -7473812523907517744, guid: 83bcb7ab64252e74d9f290d8759b294b, type: 3}
  dialogueLines:
  - sentence: "Espere, espere\u2026 acho que senti algo\u2026"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "ah, n\xE3o, era s\xF3 minha cauda batendo na \xE1gua."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Ahhh\u2026 que dia espl\xEAndido, n\xE3o \xE9? Aposto que o oceano
      at\xE9 se arrumou s\xF3 pra mim hoje."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Olha esse brilho! Essas ondas! Eu diria que est\xE1 tudo\u2026 impec\xE1vel.
      Como eu.\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Alguns dizem que eu sou modesta demais \u2014 mas o que posso fazer
      se os fatos s\xE3o os fatos?\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Falando em fatos\u2026 voc\xEA sabia que n\xF3s, baleias, somos os
      maiores seres que j\xE1 existiram na Terra?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Tr\xEAs vezes maiores que os dinossauros! E ainda assim, h\xE1 quem
      ache que tamanho n\xE3o \xE9 documento."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Minha l\xEDngua sozinha pesa seis toneladas. D\xE1 pra acreditar?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Se eu quisesse, poderia engolir um barco inteiro \u2014 mas n\xE3o
      se preocupe, n\xE3o \xE9 o meu estilo."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: Sou muito mais refinada.
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "N\xE3o enxergamos muito bem, sabia? O mar \xE9 cheio de sombras, reflexos,
      truques de luz\u2026"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "ent\xE3o, para n\xF3s, ver n\xE3o \xE9 suficiente. N\xF3s ouvimos
      o mundo."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Cada som que fa\xE7o viaja quil\xF4metros, bate nas rochas, volta
      e me conta hist\xF3rias."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "\xC9 assim que encontro o caminho, como se eu desenhasse o mapa do
      oceano com a minha pr\xF3pria voz."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "E quando tudo fica em sil\xEAncio\u2026 ainda assim eu sei pra onde
      ir."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Sinto o cora\xE7\xE3o do mundo pulsando l\xE1 embaixo, bem no fundo
      da \xE1gua.\r\n\xC9 o campo magn\xE9tico da Terra, dizem voc\xEAs."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Mas pra mim, \xE9 o planeta sussurrando:\r\n\u201CPor aqui, Blu\u2026
      por aqui.\u201D"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  hasChoice: 0
  choicePrompt: 
  choiceOptions: []
  nextDialogueOnEnd: {fileID: 0}
