  dialogueLines:
  - sentence: "Bom, bom, bom\u2026 posso te levar at\xE9 ela, sim! Mas sabe como
      \xE9\u2026 "
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "nada \xE9 de gra\xE7a nesta vida, nem mesmo nadar com uma celebridade
      aqu\xE1tica como eu.\r\n"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Para os meus clientes, tenho uma pequena exig\xEAncia:"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: 
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Para os meus clientes, tenho uma pequena exig\xEAncia:"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "adoraria que voc\xEA tocasse a minha m\xFAsica favorita."
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Ent\xE3o quer saber da \xC1rvore da Vida, \xE9 isso?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Ent\xE3o \xE9 s\xF3 eu te falar a melodia, e voc\xEA reproduz no seu
      instrumento! Fechado?"
    triggerEventAfterLine: 0
    onLineCompleteEvent:
      m_PersistentCalls:
        m_Calls: []
  - sentence: "Preste aten\xE7\xE3o! Vou cantar s\xF3 uma vez!"
