  m_Script: {fileID: 11500000, guid: e065fc2f2fa3bcb4fa8b174fad08815c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  stationCanvasGroup: {fileID: 1726064171}
  typewriter: {fileID: 457773293}
  textFragments:
  - "De l\xE1, Zelfin renasceu.\r"
  - " A harmonia retornou \xE0s \xE1guas, o vento voltou a cantar entre as folhas,
    e a vida floresceu novamente.\r\n"
  - " Ayla tornou-se a guardi\xE3 mais importante de Zelfin \u2014 aquela que vela
    pelo equil\xEDbrio e assegura que tudo permane\xE7a em seu lugar.\r\n"
  - "Hoje, ela j\xE1 n\xE3o se lembra de tudo o que aconteceu antes de chegar ali.\r\nRestou
    apenas a lembran\xE7a de uma escolha \u2014 uma decis\xE3o que mudou tudo.\r\n"
  - ' Mesmo com o vazio que ficou, Ayla seguiu em frente.

'
  - ' E, pouco a pouco, esse vazio foi sendo preenchido pela alegria e pela serenidade
    que emanam de Zelfin.

'
  OnStationCompleted:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1794145350}
        m_TargetAssemblyTypeName: AylaStorySceneController, Assembly-CSharp
        m_MethodName: MarkStationAsCompleted
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
