MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 837322115}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e065fc2f2fa3bcb4fa8b174fad08815c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  stationCanvasGroup: {fileID: 214231751}
  typewriter: {fileID: 457773293}
  textFragments:
  - " Mas\u2026 algo estava errado.\r\r"
  - " Aquilo n\xE3o resolvera o problema \u2014 apenas o espalhara.\r\n"
  - "Milhares de anos se passaram, e as part\xEDculas come\xE7aram a se reunir novamente,
    dando origem a novos esp\xEDritos \u2014 poucos, mas suficientes para abalar
    o equil\xEDbrio.\r\n"
  - "A humanidade n\xE3o aprendeu."
  - "Ent\xE3o, uma nova viajante chegou."
  - "Trazer um humano de outra realidade poderia significar tanto a salva\xE7\xE3o
    quanto a ru\xEDna daquele mundo \u2014 a \xFAltima chance de restaurar o equil\xEDbrio
    que um dia se perdeu.\r\n"
  - "Agora, as part\xEDculas espalhadas pelo sacrif\xEDcio de Ayla se misturam aos
    esp\xEDritos da viajante.\r\n"
  - "O destino, mais uma vez, come\xE7a a se mover.\r\n"
  OnStationCompleted:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1794145350}
        m_TargetAssemblyTypeName: AylaStorySceneController, Assembly-CSharp
        m_MethodName: MarkStationAsCompleted
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
